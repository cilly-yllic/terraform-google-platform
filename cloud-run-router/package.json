{
  "name": "cloud-run-router",
  "version": "0.1.0",
  "description": "TFC notification → GitHub repository_dispatch Cloud Run router (reference implementation)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src __tests__",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt src __tests__ vitest.config.ts",
    "fmt:check": "oxfmt --check src __tests__ vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13"
  }
}
